# Frontend
# Baked into the bundle at build time. Leave it EMPTY for any deployed build so
# the app calls /api/* on its own origin (vercel.json rewrites that to the
# serverless function). A localhost value in a production build points at the
# visitor's own machine and every request fails.
VITE_API_BASE_URL=http://localhost:4000
VITE_GA_MEASUREMENT_ID=
VITE_SUPABASE_URL=https://tafibcweszimipvhytft.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# Backend
PORT=4000
# Comma-separated list of browser origins allowed to call the API.
# ALLOWED_ORIGINS takes precedence; CORS_ORIGIN is the legacy name. Set this to
# your deployed site origin in production.
CORS_ORIGIN=http://localhost:5173
# ALLOWED_ORIGINS=https://your-app.vercel.app
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
SUPABASE_URL=https://tafibcweszimipvhytft.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
NEXT_PUBLIC_SUPABASE_URL=https://tafibcweszimipvhytft.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# Optional split DB vars (used when DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=free_invoice

# Email (SMTP) - required for invoice email delivery
# Using Resend (https://resend.com):
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
SMTP_FROM=onboarding@resend.dev

# BuildOS ERP integration (optional — enables two-way sync)
#
# BUILDOS_API_URL must include the /api prefix that BuildOS sets globally
# (main.ts: setGlobalPrefix('api')), and BuildOS listens on 8080 by default —
# not 3001. Every outbound call was pointed at a port nothing was serving.
BUILDOS_API_URL=http://localhost:8080/api
#
# Service credential for machine-to-machine calls into BuildOS. Generate it in
# BuildOS under Admin › API Keys; the plaintext `sk_live_…` value is shown once
# at creation and only its hash is stored, so copy it then.
#
# This replaces BUILDOS_API_TOKEN, which was documented as a JWT from a
# service-account login. BuildOS has no service-account concept and its user
# JWTs expire, so that approach broke on every token rotation.
BUILDOS_SERVICE_API_KEY=
#
# Shared secret for verifying inbound BuildOS webhooks. Must match the secret
# BuildOS generated when the webhook was registered (Admin › Webhooks).
BUILDOS_WEBHOOK_SECRET=
